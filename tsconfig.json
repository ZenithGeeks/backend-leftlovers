{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
}
